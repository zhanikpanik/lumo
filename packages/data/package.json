{
  "name": "@lumo/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "push": "instant-cli --env ../../.env.local push all",
    "seed": "node --env-file=../../.env.local --import tsx/esm src/seed.ts",
    "seed:client": "node --env-file=../../.env.local --import tsx/esm src/seed-client.ts",
    "seed:poster": "node --env-file=../../.env.local --import tsx/esm src/seed-from-poster.ts",
    "verify:permissions": "node --env-file=../../.env.local --import tsx/esm src/integration/verify-permissions.ts",
    "verify:pos-flow": "node --env-file=../../.env.local --import tsx/esm src/integration/verify-pos-flow.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@instantdb/admin": "^1.0.52",
    "@instantdb/core": "^1.0.52",
    "@noble/hashes": "^2.3.0",
    "date-fns": "^4.2.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "instant-cli": "1.0.52",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
