{
  "name": "lumo",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "start": "pnpm --filter @lumo/activation-worker start",
    "pos": "pnpm --filter @lumo/pos start",
    "pos:android": "pnpm --filter @lumo/pos android",
    "pos:ios": "pnpm --filter @lumo/pos ios",
    "pos:web": "pnpm --filter @lumo/pos web",
    "admin": "pnpm --filter @lumo/admin dev",
    "admin:build": "pnpm --filter @lumo/admin build",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:pos": "pnpm --filter @lumo/pos test",
    "instant:push:dev": "pnpm --filter @lumo/data push",
    "instant:seed:dev": "pnpm --filter @lumo/data seed",
    "instant:reset:dev": "pnpm instant:push:dev && pnpm instant:seed:dev",
    "instant:verify:revoke:dev": "pnpm instant:reset:dev && pnpm --filter @lumo/activation-worker verify:revoke",
    "instant:verify:permissions:dev": "pnpm instant:reset:dev && pnpm --filter @lumo/data verify:permissions",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "pnpm hooks:install"
  }
}
