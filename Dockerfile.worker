FROM node:22-alpine

WORKDIR /app

# Copy workspace root files needed by pnpm
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/activation-worker/package.json apps/activation-worker/
COPY packages/data/package.json packages/data/

# Install dependencies
RUN corepack enable && pnpm install --frozen-lockfile

# Copy application code
COPY apps/activation-worker/src apps/activation-worker/src/
COPY packages/data/src packages/data/src/

ENV PORT=3000
EXPOSE 3000

CMD ["node", "apps/activation-worker/src/server.mjs"]
