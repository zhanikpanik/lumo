# Alto Coffee POS — Expo environment variables
# Copy this file to .env and fill with actual credentials.
# .env is gitignored — never commit real keys.
# InstantDB foundation. Use the environment-specific app ID; the ID is public,
# but the corresponding admin token must remain server/seed-only.
EXPO_PUBLIC_INSTANT_ENV=development
EXPO_PUBLIC_INSTANT_APP_ID=your-development-instant-app-id
EXPO_PUBLIC_ACTIVATION_WORKER_URL=https://your-activation-worker.example.com

# Print Bridge — HTTP→TCP ESC/POS gateway for receipt printer
# Start with: ./scripts/start-print-bridge.sh [printer_ip]
EXPO_PUBLIC_PRINT_BRIDGE_URL=http://localhost:3456
