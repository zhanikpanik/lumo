{
  "name": "@lumo/pos",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo/web",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:@noble/hashes|uuid|\\.pnpm/(?:@noble\\+hashes|uuid)@))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.1",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@instantdb/react": "^1.0.52",
    "@instantdb/react-native": "^1.0.52",
    "@lumo/data": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.6",
    "typescript": "^5.3.3"
  },
  "private": true
}
