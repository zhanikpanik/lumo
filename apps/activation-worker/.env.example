# Server-only. Never expose INSTANT_ADMIN_TOKEN to a Vite or Expo client.
INSTANT_APP_ID=your-development-instant-app-id
INSTANT_ADMIN_TOKEN=your-server-only-instant-admin-token
PORT=3000
# Comma-separated browser origins permitted to call the worker. Native POS calls have no Origin header.
ACTIVATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# One-time Phase 1 bootstrap; set only while running `pnpm bootstrap:admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
ADMIN_ORGANIZATION_NAME=Alto Coffee
ADMIN_ORGANIZATION_SLUG=alto-coffee
ADMIN_VENUE_ID=00000000-0000-0000-0000-000000000000
ADMIN_VENUE_NAME=Alto Coffee Bishkek
ADMIN_VENUE_SLUG=alto-coffee-bishkek
ADMIN_CURRENCY=KGS
ADMIN_TIME_ZONE=Asia/Bishkek
ADMIN_VENUE_TYPE=restaurant
ADMIN_ROLE=owner
