# r_keeper-admin — Supabase credentials
# Copy this file to .env and fill with actual values.
# .env is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_VENUE_ID=00000000-0000-0000-0000-000000000000
VITE_ORG_ID=00000000-0000-0000-0000-000000000000
VITE_REQUIRE_AUTH=false

# InstantDB foundation. Use the environment-specific app ID; never expose an
# Instant admin token in Vite variables.
VITE_INSTANT_ENV=development
VITE_INSTANT_APP_ID=your-development-instant-app-id
VITE_ACTIVATION_WORKER_URL=https://your-activation-worker.example.com
